# Supabase project (Settings → API). The anon key is public by design; RLS protects the data.
# Leave both empty to run in local demo mode (synthetic data, changes saved only in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public origin the app is served from; used for magic-link redirects.
VITE_SITE_URL=https://michael-han.com/hardest

# Set to "true" if Google OAuth is enabled in Supabase Auth → Providers.
VITE_ENABLE_GOOGLE_AUTH=false

# Optional AI-assisted parsing. This is a Supabase Edge Function name (see supabase/functions/parse-assignment).
# The Anthropic key lives ONLY in Supabase secrets (supabase secrets set ANTHROPIC_API_KEY=...), never here.
VITE_ENABLE_AI_PARSER=false

# Only for scripts (scripts/test-db.sh); never exposed to the browser.
# DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
