{
  "name": "hardest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Crowdsourced difficulty ratings for every assignment, problem, and course.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
